# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Engine Service URL & Security Key
NEXT_PUBLIC_AI_ENGINE_URL=http://127.0.0.1:8001
AI_ENGINE_API_KEY=dev-key-educraft

# Provider AI: OpenAI-compatible endpoint
AI_PROVIDER=openai
OPENAI_BASE_URL=https://9router.example.com/v1
OPENAI_API_KEYS=your-api-key
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=ag/gemini-3.8-flash-high

# Google OAuth Client ID (Export Google Forms)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
